{
  "name": "exam-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "db:new": "supabase migration new",
    "db:push": "supabase db push --remote",
    "db:status": "supabase migration list --remote",
    "db:test": "supabase test db --remote",
    "db:test:remote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-test-remote.ps1",
    "fn:deploy": "supabase functions deploy --use-api",
    "db:types": "supabase gen types --lang typescript --schema public --remote > src/lib/database.types.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-ethiopic": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.0.1",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "react-router": "^8.5.1",
    "read-excel-file": "^5.8.8",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
