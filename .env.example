# Copy to .env.local and fill in. Only public values belong here — never the service role key.
# Supabase dashboard → Project Settings → API (or Data API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Shows the email/password dev login form. Only honoured by `npm run dev`; production
# builds strip the form regardless of this value. Never set this on Vercel.
VITE_ENABLE_DEV_LOGIN=true
